# Settings for compose.external.yaml (or `docker run --env-file server.env`). Copy to server.env, which is
# git-ignored, and keep it readable only by you: it holds the database password and the client secret.
# One NAME=value per line, no quotes. Every setting is in apps/server/README.md.

# Your PostgreSQL 14 or newer. The first start runs the migrations and `CREATE EXTENSION pg_trgm`, so the user needs
# that right (or an administrator runs it once). Add ?sslmode=require for a managed database.
DATABASE_URL=postgres://thoth:CHANGE_ME@db.example.org:5432/thoth?sslmode=require

# The address people use to reach this server, through your HTTPS proxy. Required for sign-in.
PUBLIC_URL=https://thoth.example.org
# The proxy sets X-Forwarded-For; the server needs it for per-IP limits.
TRUST_PROXY=true

# Your OpenID Connect provider (Keycloak, Authentik, Zitadel, Entra ID...). Register this redirect URI there:
#   https://thoth.example.org/auth/callback/oidc
OIDC_ISSUER=https://auth.example.org/realms/main
OIDC_CLIENT_ID=thoth
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_NAME=Company sign-in

# Optional, alongside or instead of your provider (redirect URIs /auth/callback/google and /auth/callback/github):
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Behind a connection pooler (PgBouncer, Neon's -pooler host): migrate once with a direct URL instead,
#   docker compose -f compose.external.yaml run --rm -e DATABASE_URL=<direct url> server node src/cli.ts migrate
# MIGRATE_ON_START=false
# DATABASE_POOL_MAX=3

# Attachments are files in the `blobs` volume. To keep them in PostgreSQL instead:
# BLOB_STORE=postgres

# A web client you build yourself for this server (VITE_DEFAULT_SERVER=https://thoth.example.org):
# WEB_REDIRECT_URIS=https://notes.example.org/app/callback
# CORS_ORIGINS=https://notes.example.org
