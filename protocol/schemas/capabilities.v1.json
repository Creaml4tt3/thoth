{
  "$id": "https://thoth.invalid/schemas/capabilities.v1.json",
  "title": "capabilities.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "attachments",
              "search",
              "events.sse",
              "transfers",
              "page-order",
              "page-kind",
              "public-share",
              "members",
              "invite-links",
              "workspace-management",
              "feedback",
              "databases",
              "realtime-collab"
            ]
          },
          {
            "type": "string",
            "pattern": "^x-[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        ]
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxMarkdownBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAttachmentBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxPageSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idempotencyWindowSeconds": {
          "type": "integer",
          "minimum": 86400,
          "maximum": 9007199254740991
        },
        "maxPagesPerWorkspace": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxWorkspaceAttachmentBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxMembersPerWorkspace": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxWorkspacesPerAccount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "revisionRetentionDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "signIn": {
      "type": "object",
      "properties": {
        "authorizationEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "tokenEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "revocationEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "providers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        }
      },
      "required": [
        "authorizationEndpoint",
        "tokenEndpoint",
        "revocationEndpoint",
        "providers"
      ]
    }
  },
  "required": [
    "protocolVersion",
    "capabilities"
  ]
}
