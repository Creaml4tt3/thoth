{
  "$id": "https://thoth.invalid/schemas/page-visibility.v1.json",
  "title": "page-visibility.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "teamIds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.~-]+$"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "limitedAbove": {
      "type": "boolean"
    }
  },
  "required": [
    "pageId",
    "teamIds",
    "limitedAbove"
  ]
}
