{
  "$id": "https://thoth.invalid/schemas/invite-link-create-request.v1.json",
  "title": "invite-link-create-request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "editor",
        "viewer"
      ]
    },
    "expiresInDays": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 7
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    },
    "maxUses": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 5
        },
        {
          "type": "number",
          "const": 10
        }
      ]
    }
  },
  "required": [
    "role"
  ]
}
