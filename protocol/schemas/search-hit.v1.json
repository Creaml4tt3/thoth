{
  "$id": "https://thoth.invalid/schemas/search-hit.v1.json",
  "title": "search-hit.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string"
    },
    "revisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.~-]+$"
    },
    "snippet": {
      "type": "string"
    },
    "score": {
      "type": "number"
    }
  },
  "required": [
    "pageId",
    "title",
    "revisionId"
  ]
}
