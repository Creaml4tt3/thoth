{
  "$id": "https://thoth.invalid/schemas/page-summary.v1.json",
  "title": "page-summary.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "contentHash": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mtimeMs": {
      "type": "number"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "id",
    "path",
    "title",
    "contentHash",
    "size",
    "mtimeMs",
    "aliases",
    "tags"
  ],
  "additionalProperties": false
}
