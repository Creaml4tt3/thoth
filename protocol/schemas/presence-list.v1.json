{
  "$id": "https://thoth.invalid/schemas/presence-list.v1.json",
  "title": "presence-list.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.~-]+$"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "displayName"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}
