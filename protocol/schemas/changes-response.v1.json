{
  "$id": "https://thoth.invalid/schemas/changes-response.v1.json",
  "title": "changes-response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.~-]+$"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "page.created",
                  "page.updated",
                  "page.deleted",
                  "attachment.created"
                ]
              },
              {
                "type": "string",
                "pattern": "^x-[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "actorId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.~-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pageId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.~-]+$"
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "attachmentId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "id",
          "kind",
          "occurredAt",
          "actorId"
        ]
      },
      "description": "Changes after the request cursor, oldest first."
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_.~-]+$",
      "description": "Opaque position after the last returned entry. Pass it back as `cursor` to continue."
    },
    "hasMore": {
      "type": "boolean",
      "description": "True when more entries are available now; read until false."
    }
  },
  "required": [
    "entries",
    "cursor",
    "hasMore"
  ]
}
