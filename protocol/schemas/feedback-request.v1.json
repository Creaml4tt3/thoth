{
  "$id": "https://thoth.invalid/schemas/feedback-request.v1.json",
  "title": "feedback-request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "problem",
        "idea",
        "question"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "context": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "enum": [
            "desktop",
            "web",
            "site"
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        }
      },
      "required": [
        "client"
      ],
      "additionalProperties": false
    },
    "website": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "kind",
    "message"
  ],
  "additionalProperties": false
}
