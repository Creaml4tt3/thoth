{
  "$id": "https://thoth.invalid/schemas/feedback-context.v1.json",
  "title": "feedback-context.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "enum": [
        "desktop",
        "web",
        "site"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "language": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    }
  },
  "required": [
    "client"
  ],
  "additionalProperties": false
}
