{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the main window and Thoth's own windows on a Private Space (space-*, ADR-0019): Thoth's host commands, event listening, and showing a system notification (check and ask for the permission, notify; ADR-0018). No fs, shell, http, opener or window plugins, and no log: permission (the log plugin is used from the host only, ADR-0040); native dialogs, the system browser, every server request, link previews (ADR-0020), the update notice's one request for latest.json (ADR-0022), the downloads and installs of in-app updates (ADR-0034; no plugin permission), the Connected apps socket for thoth-mcp (ADR-0021) and the Agent Hub's CLI runs are made by the host, not the webview.",
  "windows": [
    "main",
    "space-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-vault-pick",
    "allow-vault-recent",
    "allow-vault-open",
    "allow-vault-close",
    "allow-vault-reveal",
    "allow-vault-shared",
    "allow-vault-trash",
    "allow-window-open",
    "allow-window-close",
    "allow-fs-stat",
    "allow-fs-read",
    "allow-fs-list",
    "allow-fs-mkdirp",
    "allow-fs-write",
    "allow-fs-rename",
    "allow-fs-remove",
    "allow-sql-exec",
    "allow-sql-run",
    "allow-sql-all",
    "allow-sql-get",
    "allow-watch-start",
    "allow-watch-stop",
    "allow-source-pick",
    "allow-source-open",
    "allow-source-list",
    "allow-source-file-open",
    "allow-source-file-read",
    "allow-source-file-close",
    "allow-source-temp-create",
    "allow-source-temp-write",
    "allow-source-close",
    "allow-image-pick",
    "allow-image-read",
    "allow-file-save",
    "allow-server-list",
    "allow-server-add",
    "allow-server-remove",
    "allow-server-signIn",
    "allow-server-signInCancel",
    "allow-server-useToken",
    "allow-server-signOut",
    "allow-api-call",
    "allow-agent-detect",
    "allow-agent-run-create",
    "allow-agent-fs-stat",
    "allow-agent-fs-read",
    "allow-agent-fs-list",
    "allow-agent-fs-mkdirp",
    "allow-agent-fs-write",
    "allow-agent-start",
    "allow-agent-events",
    "allow-agent-cancel",
    "allow-agent-run-dispose",
    "allow-agent-sweep",
    "allow-agent-history-write",
    "allow-agent-history-read",
    "allow-agent-history-list",
    "allow-agent-history-delete",
    "allow-link-preview",
    "allow-link-preview-clear",
    "allow-link-open",
    "allow-update-check",
    "allow-update-settings",
    "allow-update-install",
    "allow-update-cancel",
    "allow-update-status",
    "allow-update-restart",
    "allow-mcp-settings",
