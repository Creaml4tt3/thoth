# Maintainer: Creaml4tt3
# The upstream .deb from download.thothnotes.com, unpacked as it is (AUR rules: prebuilt packages end in -bin).
# "thoth" and "thoth-bin" on the AUR are an unrelated terminal scratchpad (jooaf/thoth); no file clashes with it.
pkgname=thoth-notes-bin
pkgver=0.9.0
pkgrel=1
pkgdesc="Notes in plain Markdown files on your computer, with shared workspaces you can host yourself"
arch=('x86_64')
url="https://thothnotes.com/"
license=('Apache-2.0')
depends=('cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libgcc' 'libsoup3' 'webkit2gtk-4.1')
options=('!strip' '!debug')
source=("https://download.thothnotes.com/v${pkgver}/Thoth_${pkgver}_amd64.deb")
sha256sums=('03352d287917fe41ae9231f58116d26621392cae0d4a325f685ca3b165939b1f')

package() {
  # makepkg has already unpacked the .deb (an ar archive) into data.tar.gz and control.tar.gz.
  bsdtar -xf data.tar.gz -C "${pkgdir}"
}
