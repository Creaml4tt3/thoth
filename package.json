{
  "name": "thoth",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json && tsc -p packages/app-ui/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/site/tsconfig.json",
    "check": "pnpm typecheck && pnpm schemas:check && pnpm openapi:check && pnpm test",
    "turbo": "turbo",
    "schemas": "node scripts/generate-schemas.ts",
    "schemas:check": "node scripts/generate-schemas.ts --check",
    "openapi": "node scripts/generate-openapi.ts",
    "openapi:check": "node scripts/generate-openapi.ts --check",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "build:website": "node scripts/build-website.ts",
    "test:server": "vitest run -c apps/server/test-db/vitest.config.ts",
    "server:conformance": "node apps/server/scripts/server-conformance.ts",
    "video": "node design/video/build.ts",
    "video:record": "node design/video/record.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.1",
    "@thoth/content": "workspace:*",
    "@thoth/desktop": "workspace:*",
    "@thoth/domain": "workspace:*",
    "@thoth/editor": "workspace:*",
    "@thoth/importer-core": "workspace:*",
    "@thoth/importer-notion": "workspace:*",
    "@thoth/importer-obsidian": "workspace:*",
    "@thoth/local-store": "workspace:*",
    "@thoth/platform": "workspace:*",
    "@thoth/workspace-client": "workspace:*",
    "@thoth/workspace-protocol": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/yazl": "^3.3.1",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
