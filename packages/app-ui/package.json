    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@thoth/content": "workspace:*",
    "@thoth/domain": "workspace:*",
    "@thoth/editor": "workspace:*",
    "@thoth/platform": "workspace:*",
    "@thoth/workspace-client": "workspace:*",
    "@thoth/workspace-protocol": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "diff": "^9.0.0",
    "react": "^19.3.1",
