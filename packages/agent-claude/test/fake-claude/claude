#!/usr/bin/env node
// A fake Claude Code CLI for tests: CI never calls a real model. It answers the probes the host runs
// (`--version`, `--help`, `auth status --json`) and, in print mode, reads the prompt from stdin, records what it
// was given, acts on directives in the prompt, and prints stream-json events shaped like Claude Code 2.1.310's
// (see ../fixtures/README.md).
//
// Environment:
//   FAKE_CLAUDE_RECORD=<dir>    write <dir>/run-<pid>.json: argv, cwd, env, stdin, the files in cwd and their modes, pids
//                               (default: fake-claude-record.json next to the working directory, outside it)
//   FAKE_CLAUDE_VERSION=<text>  what --version prints (default "2.1.310 (Claude Code)")
//   FAKE_CLAUDE_HELP=old        --help without --restricted and --permission-prompts
//   FAKE_CLAUDE_LOGGED_OUT=1    auth status says loggedIn: false
//
// Directives (one per prompt line; paths are relative to the working directory):
//   @replace PATH :: OLD => NEW      @write PATH :: TEXT (\n for a newline)     @delete PATH
//   @symlink PATH -> TARGET          @mkdir PATH                                @say TEXT
//   @unlock PATH (make a read-only file writable, as an agent that works around a file mode would)
//   @answer TEXT (the final message and the result's text, instead of "Done."; \n for a newline)
//   @answer-long N (an answer of N letters)
//   @echo-context (answers with how many earlier turns of a conversation its input quoted, and the first question)
// In a follow-up, only the lines after "--- End of earlier turns ---" are read for directives.
//   @sleep MS                        @hang (start a grandchild, then wait to be killed)
//   @ignore-term (ignore SIGTERM)    @not-logged-in                             @exit CODE
//   @budget (stop the way Claude Code does when --max-budget-usd is used up: a result with subtype
//           error_max_budget_usd and no result text, exit 1; see ../fixtures/stream-budget.jsonl)
import { spawn } from "node:child_process";
import { chmodSync, mkdirSync, readFileSync, readdirSync, lstatSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";

const argv = process.argv.slice(2);
const out = (text) => process.stdout.write(text);
const emit = (event) => out(`${JSON.stringify(event)}\n`);
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const SESSION = "00000000-0000-4000-8000-0000000000aa";
let uuid = 0;
const id = () => `00000000-0000-4000-8000-${String(++uuid).padStart(12, "0")}`;

if (argv[0] === "--version" || argv[0] === "-v") {
  out(`${process.env.FAKE_CLAUDE_VERSION ?? "2.1.310 (Claude Code)"}\n`);
  process.exit(0);
}
if (argv[0] === "--help" || argv[0] === "-h") {
  let help = readFileSync(new URL("../fixtures/help-2.1.310.txt", import.meta.url), "utf8");
  if (process.env.FAKE_CLAUDE_HELP === "old") help = help.replace(/--restricted/g, "--restrict-x").replace(/--permission-prompts/g, "--permission-x");
  out(help);
  process.exit(0);
}
if (argv[0] === "auth" && argv[1] === "status") {
  const loggedIn = process.env.FAKE_CLAUDE_LOGGED_OUT !== "1";
  out(`${JSON.stringify({ loggedIn, authMethod: loggedIn ? "oauth_token" : "none", apiProvider: "firstParty" }, null, 2)}\n`);
  process.exit(loggedIn ? 0 : 1);
}
if (!argv.includes("-p")) {
  process.stderr.write("fake claude: only print mode (-p) is supported\n");
  process.exit(2);
}

const chunks = [];
for await (const chunk of process.stdin) chunks.push(chunk);
const prompt = Buffer.concat(chunks).toString("utf8");
const cwd = process.cwd();

function listing(dir, prefix = "") {
  const entries = [];
  for (const name of readdirSync(dir).sort()) {
    const path = prefix ? `${prefix}/${name}` : name;
    const st = lstatSync(join(dir, name));
    const kind = st.isSymbolicLink() ? "symlink" : st.isDirectory() ? "directory" : "file";
    entries.push({ path, kind });
    if (kind === "directory") entries.push(...listing(join(dir, name), path));
  }
  return entries;
}

const modes = {};
for (const { path } of listing(cwd)) modes[path] = lstatSync(join(cwd, path)).mode & 0o777;
const record = { pid: process.pid, argv, cwd, env: process.env, stdin: prompt, files: listing(cwd), modes, grandchild: null };
const recordFile = process.env.FAKE_CLAUDE_RECORD ? join(process.env.FAKE_CLAUDE_RECORD, `run-${process.pid}.json`) : join(cwd, "..", "fake-claude-record.json");
const save = () => recordFile && writeFileSync(recordFile, JSON.stringify(record, null, 2));
save();

process.on("SIGTERM", () => {
  if (ignoreTerm) return;
  process.exit(143); // what Claude Code does on SIGTERM
});
let ignoreTerm = false;

const model = argv.includes("--model") ? argv[argv.indexOf("--model") + 1] : "claude-fake-1";
const toolsArg = argv.includes("--tools") ? argv[argv.indexOf("--tools") + 1] : "";
emit({ type: "system", subtype: "init", cwd, session_id: SESSION, tools: toolsArg.split(",").filter(Boolean).sort(), mcp_servers: [], model, permissionMode: argv.includes("--permission-mode") ? argv[argv.indexOf("--permission-mode") + 1] : "default", slash_commands: [], apiKeySource: "none", claude_code_version: "2.1.310", uuid: id() });
emit({ type: "rate_limit_event", rate_limit_info: { status: "allowed" }, uuid: id(), session_id: SESSION });

const assistant = (content, extra = {}) => emit({ type: "assistant", message: { model, id: `msg_${uuid}`, type: "message", role: "assistant", content, stop_reason: null }, parent_tool_use_id: null, session_id: SESSION, uuid: id(), ...extra });
const toolResult = (toolUseId, content, isError = false) => emit({ type: "user", message: { role: "user", content: [{ tool_use_id: toolUseId, type: "tool_result", content, ...(isError ? { is_error: true } : {}) }] }, parent_tool_use_id: null, session_id: SESSION, uuid: id() });
let turns = 0;
let tool = 0;
let answer = "Done.";
const useTool = (name, input) => {
  const toolId = `toolu_fake_${++tool}`;
  assistant([{ type: "tool_use", id: toolId, name, input, caller: { type: "direct" } }]);
  turns++;
  return toolId;
};

// A follow-up (ADR-0007, "Conversations") quotes the earlier turns before the new question: their directives are
// context, not instructions for this run, so only the lines after the end of the quoted turns are acted on.
const END_OF_TURNS = "--- End of earlier turns ---";
const lines = prompt.split("\n");
const end = lines.lastIndexOf(END_OF_TURNS);
const earlier = end < 0 ? [] : lines.slice(0, end);
const earlierTurns = earlier.filter((l) => /^--- Earlier turn \d+ ---$/.test(l)).length;

for (const raw of lines.slice(end + 1)) {
  const line = raw.trim();
  if (!line.startsWith("@")) continue;
  const [directive, ...rest] = line.split(" ");
  const arg = rest.join(" ");
  if (directive === "@replace") {
    const [path, change] = arg.split(" :: ");
    const [from, to] = change.split(" => ");
    const file = join(cwd, path);
    const toolId = useTool("Edit", { file_path: file, old_string: from, new_string: to, replace_all: false });
    const text = readFileSync(file, "utf8");
    if (!text.includes(from)) toolResult(toolId, `String to replace not found in file.\nString: ${from}`, true);
    else {
      try {
        writeFileSync(file, text.replace(from, to));
        toolResult(toolId, `The file ${file} has been updated successfully.`);
      } catch (error) {
        toolResult(toolId, `${error.code}: permission denied, open '${file}'`, true);
      }
    }
  } else if (directive === "@write") {
    const [path, text] = arg.split(" :: ");
    const file = join(cwd, path);
    const toolId = useTool("Write", { file_path: file, content: text.replaceAll("\\n", "\n") });
    try {
      mkdirSync(dirname(file), { recursive: true });
      writeFileSync(file, text.replaceAll("\\n", "\n"));
      toolResult(toolId, `File created successfully at: ${file}`);
    } catch (error) {
      toolResult(toolId, `${error.code}: permission denied, open '${file}'`, true);
    }
  } else if (directive === "@unlock") {
    chmodSync(join(cwd, arg), 0o644);
  } else if (directive === "@delete") {
    rmSync(join(cwd, arg), { force: true });
    turns++;
  } else if (directive === "@symlink") {
    const [path, target] = arg.split(" -> ");
    symlinkSync(target, join(cwd, path));
  } else if (directive === "@mkdir") {
    mkdirSync(join(cwd, arg), { recursive: true });
  } else if (directive === "@say") {
    assistant([{ type: "text", text: arg }]);
  } else if (directive === "@answer") {
    answer = arg.replaceAll("\\n", "\n");
  } else if (directive === "@answer-long") {
    answer = "a".repeat(Number(arg));
  } else if (directive === "@echo-context") {
    // Says what the input held before the new question: how many earlier turns, and the first one's question.
    const first = earlier.indexOf("Question:");
    answer = earlierTurns === 0 ? "No earlier turns in my input." : `Earlier turns in my input: ${earlierTurns}. The first question was: ${earlier[first + 2] ?? "?"}`;
  } else if (directive === "@sleep") {
    await sleep(Number(arg));
  } else if (directive === "@ignore-term") {
    ignoreTerm = true;
  } else if (directive === "@hang") {
    const child = spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], { stdio: "ignore" });
    record.grandchild = child.pid;
    save();
    assistant([{ type: "text", text: "Working on it…" }]);
    await new Promise(() => setInterval(() => {}, 1000));
  } else if (directive === "@not-logged-in") {
    assistant([{ type: "text", text: "Not logged in · Please run /login" }], { error: "authentication_failed" });
    emit({ type: "result", subtype: "success", is_error: true, duration_ms: 40, num_turns: 1, result: "Not logged in · Please run /login", session_id: SESSION, total_cost_usd: 0, terminal_reason: "api_error", uuid: id() });
    process.exit(1);
  } else if (directive === "@budget") {
    const limit = argv.includes("--max-budget-usd") ? argv[argv.indexOf("--max-budget-usd") + 1] : "0.0001";
    assistant([{ type: "text", text: "Working on it…" }]);
    emit({ type: "result", subtype: "error_max_budget_usd", is_error: true, duration_ms: 1398, num_turns: turns + 1, session_id: SESSION, total_cost_usd: Number(limit) + 0.0001, errors: [`Reached maximum budget ($${limit})`], permission_denials: [], terminal_reason: "budget_exhausted", uuid: id() });
    process.exit(1);
  } else if (directive === "@exit") {
    process.stderr.write("fake claude: exiting early\n");
    process.exit(Number(arg));
  }
}

assistant([{ type: "text", text: answer }]);
emit({ type: "result", subtype: "success", is_error: false, duration_ms: 1234, num_turns: turns + 1, result: answer, session_id: SESSION, total_cost_usd: 0.0012, permission_denials: [], terminal_reason: "completed", uuid: id() });
