{
  "extends": "./tsconfig.base.json",
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "protocol/conformance/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "tests/fixtures/**",
    "apps/desktop/**"
  ]
}
